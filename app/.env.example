# Optional override for the API origin. Leave it unset during development: the
# app derives the host from the Expo dev server, so the same build works on web,
# an Android emulator, and a physical phone on the same Wi-Fi.
#
# Set it for a deployed API, a tunnel, or an API that is not on port 8080:
# EXPO_PUBLIC_API_URL=https://api.example.com

